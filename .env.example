# VOIDWARE BUTTON PANIC - Environment Configuration Reference
# Local Development: No environment variables needed (Vite proxy routes /api and /ws to 127.0.0.1:8000)

# Production Frontend (Set in Vercel Project Settings > Environment Variables):
# Point this to your Render backend URL (e.g. https://voidware-panic-api.onrender.com)
VITE_API_URL=https://your-backend-service.onrender.com

# Optional (Automatically derived from VITE_API_URL if omitted):
# VITE_WS_URL=wss://your-backend-service.onrender.com/ws

# Production Backend (Set in Render Dashboard > Environment Variables):
# DATABASE_URL=postgresql://username:password@ep-something.neon.tech/button_panic?sslmode=require
# ALLOWED_ORIGINS=https://your-frontend-project.vercel.app
